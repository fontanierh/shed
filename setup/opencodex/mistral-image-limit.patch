diff --git a/src/server/responses/mistral-image-limit.ts b/src/server/responses/mistral-image-limit.ts
new file mode 100644
index 000000000..727d9f749
--- /dev/null
+++ b/src/server/responses/mistral-image-limit.ts
@@ -0,0 +1,74 @@
+import type { TranslatorBudget } from "../../lib/translator-budget";
+import type { AdapterRequest } from "../../adapters/base";
+
+// https://docs.mistral.ai/capabilities/vision/ documents 8 images per API request, and most
+// Mistral vision models refuse a ninth with HTTP 400 ("Total number of images exceeds the maximum
+// allowed of 8"). Some models accept more; DeepSeek V4.1 Flash answers an opaque HTTP 503 (code
+// 3800) past its cap. Operators declare a model's cap with `modelCapabilities.<id>.mistralMaxImages`.
+export const MISTRAL_DEFAULT_MAX_IMAGES = 8;
+/**
+ * Caps measured on api.mistral.ai (2026-11-04) for models above the documented 8: the largest
+ * accepted count before refusal, or for GLM the largest count tried without one.
+ */
+const MEASURED_MAX_IMAGES: Readonly<Record<string, number>> = {
+  "deepseek-v4-1-flash-1017": 20,
+  "mistral-large-4": 100,
+  "mistral-large-4-0": 100,
+  "zai-glm-5-3-flash": 256,
+};
+
+/** The operator's declaration, then a measured cap, then the documented default. */
+export function mistralMaxImages(model: string, declared?: number): number {
+  return declared ?? (Object.hasOwn(MEASURED_MAX_IMAGES, model) ? MEASURED_MAX_IMAGES[model]! : MISTRAL_DEFAULT_MAX_IMAGES);
+}
+
+const NOTE = "[image omitted: Mistral accepts a limited number of images per request; older images were dropped]";
+
+/** Narrow parsed JSON objects without treating arrays as image or message records. */
+function record(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+/** Only the first-party Chat destination, never a similarly named gateway. */
+export function isMistralChatRequest(request: AdapterRequest): boolean {
+  try {
+    const url = new URL(request.url);
+    return url.origin === "https://api.mistral.ai" && url.pathname === "/v1/chat/completions" && request.method === "POST";
+  } catch { return false; }
+}
+
+/**
+ * Keep the newest images a Mistral request may carry and replace older ones with a text note,
+ * across every message (including promoted tool-result images). The client history stays intact;
+ * only this outbound body is pruned. Returns undefined when nothing needs to change.
+ */
+export function mistralImageLimitBody(
+  request: AdapterRequest,
+  options: { maxImages: number; budget?: TranslatorBudget },
+): string | undefined {
+  if (!isMistralChatRequest(request)) return undefined;
+  // Cheap bound before parsing: a request with no more image parts than the cap is never rewritten.
+  let occurrences = 0;
+  for (let at = request.body.indexOf('"image_url"'); at !== -1; at = request.body.indexOf('"image_url"', at + 1)) {
+    if (++occurrences > options.maxImages) break;
+  }
+  if (occurrences <= options.maxImages) return undefined;
+  const requestBytes = Buffer.byteLength(request.body, "utf8");
+  const releaseCopy = options.budget?.observeAcceptedRequestCopy(requestBytes * 2);
+  try {
+    const body: unknown = JSON.parse(request.body);
+    if (!record(body) || !Array.isArray(body.messages)) return undefined;
+    const images: Array<{ parts: unknown[]; index: number }> = [];
+    for (const message of body.messages) {
+      if (!record(message) || !Array.isArray(message.content)) continue;
+      message.content.forEach((part, index) => {
+        if (record(part) && part.type === "image_url") images.push({ parts: message.content as unknown[], index });
+      });
+    }
+    const excess = images.length - options.maxImages;
+    if (excess <= 0) return undefined;
+    for (const { parts, index } of images.slice(0, excess)) parts[index] = { type: "text", text: NOTE };
+    const releaseSerialization = options.budget?.observeExternallyCapped("passthrough_serialization", requestBytes);
+    try { return JSON.stringify(body); } finally { releaseSerialization?.(); }
+  } finally { releaseCopy?.(); }
+}
